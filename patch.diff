-    path = string.gsub(path, "/", "\\")
-    return path
-end
-
 local function IsSkillActive(iconTexture)
     if not iconTexture or iconTexture == "" then return false end
-    local normTarget = NormalizeTexture(iconTexture)
     
     local numForms = GetNumShapeshiftForms()
